APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set SESSION_SECURE_COOKIE=true. Left unset, Laravel infers the Secure
# flag from whether the request looks encrypted — which behind a TLS-terminating
# proxy it does not, unless TRUSTED_PROXIES below is also set. Do not rely on
# inference for the admin session cookie.
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Reverse proxy / TLS termination
# ---------------------------------------------------------------------------
# Unset means "trust nothing", which is correct for a direct-to-PHP local setup.
# Behind nginx/Apache/a load balancer/Cloudflare this MUST be set, or the app sees
# plain HTTP from the proxy's address: generated media URLs come out as http://,
# the session cookie loses Secure, and the handshake rate limiter buckets the whole
# fleet under one IP. See config/trustedproxy.php and docs/production-env.md.
#   REMOTE_ADDR         one reverse proxy on the same host (preferred)
#   10.0.0.4,10.0.0.5  an explicit load-balancer list
#   *                  trust the caller — only when the origin is unreachable
#                      except through the proxy
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Device signing secrets are per device and are generated at pairing time; they
# live encrypted in screen_device_credentials. There is no fleet-wide key.
SCREENS_SIGNATURE_LEEWAY=300
SCREENS_PAIRING_CODE_TTL=900
SCREENS_HEARTBEAT_INTERVAL=60
# Silence tolerated before a screen is marked offline. Defaults to twice the
# heartbeat interval; always floored at interval + 1. Read via App\Support\ScreenHealth.
SCREENS_OFFLINE_AFTER=120
SCREENS_PLAYLIST_TTL=300
SCREENS_CONFIG_TTL=900

PLAYLIST_TTL=300
# Superseded by SCREENS_OFFLINE_AFTER above. No config file has ever read this
# key; it is left here only so existing .env files are not silently contradicted.
HEARTBEAT_OFFLINE_THRESHOLD=120

# ---------------------------------------------------------------------------
# Operational alerting
# ---------------------------------------------------------------------------
# Where fleet alerts go (screen offline, ad expiring). One operations mailbox —
# use a distribution address if several people need them. Falls back to
# ADMIN_EMAIL when unset.
#
# With neither set, detection still runs and still records the transition, but
# delivery is skipped and a warning is logged. `php artisan ops:status` reports
# this and exits 1. See docs/operations-runbook.md.
OPS_NOTIFICATION_EMAIL=

# Slack is optional. The webhook takes precedence; the bot route needs BOTH the
# token and the channel, or it is ignored.
SLACK_WEBHOOK_URL=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# ---------------------------------------------------------------------------
# Operational data retention (days)
# ---------------------------------------------------------------------------
# EMPTY MEANS KEEP EVERYTHING. Nothing is pruned until a positive value is set;
# zero, negative and non-numeric values also mean "disabled", never "0 days".
#
# screen_logs grows at roughly fleet size x 1440 rows/day. playback_logs is
# proof-of-play evidence — confirm the commercial requirement before setting it.
# Reports are immutable snapshots and are the only surviving copy of their figures.
#
# Preview before enabling:
#   php artisan model:prune --model="App\Models\ScreenLog" --pretend
SCREEN_LOG_RETENTION_DAYS=
PLAYBACK_LOG_RETENTION_DAYS=
REPORT_RETENTION_DAYS=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Creative media / video duration
# ---------------------------------------------------------------------------
# With probing OFF, an operator MUST type a duration for every video: the admin
# form now refuses a video whose duration is unknown rather than storing zero and
# handing an unplayable item to a screen. Turning probing ON requires a working
# ffprobe binary on the web/PHP host — verify with `ffprobe -version` as the PHP
# user, not as yourself. See docs/production-env.md.
ADS_TRY_FFPROBE=false
FFPROBE_BIN=ffprobe
ADS_FALLBACK_URL=/images/fallback.png
ADS_FALLBACK_TYPE=image
ADS_FALLBACK_DURATION=30

# Application upload ceilings, in kilobytes. PHP's upload_max_filesize/post_max_size
# and the web server's body limit must all be at least as large, or the platform
# rejects the upload before these are ever consulted. See docs/production-env.md.
# ADS_IMAGE_MAX_KB=5120
# ADS_GIF_MAX_KB=10240
# ADS_VIDEO_MAX_KB=153600

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
# Longest period a single report may cover, in days. Default 366. A screen-uptime
# report walks the log timeline per screen, so an unbounded period is an
# authenticated denial-of-service. Empty/zero/negative means no ceiling.
# REPORT_MAX_PERIOD_DAYS=366
